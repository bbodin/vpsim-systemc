cmake_minimum_required(VERSION 3.20)

project(tbb-download NONE)

include(ExternalProject)
ExternalProject_Add(tbb
    GIT_REPOSITORY https://github.com/wjakob/tbb.git
    SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/extern/tbb"
        # --- Patch step: remove tests  ---
    PATCH_COMMAND
        ${CMAKE_COMMAND} -DSRC=${CMAKE_CURRENT_SOURCE_DIR}/extern/systemc/CMakeLists.txt
                        -P ${CMAKE_CURRENT_SOURCE_DIR}/CMake/remove_tbb_test.cmake

    CONFIGURE_COMMAND ""
    BUILD_COMMAND ""
    INSTALL_COMMAND ""
    TEST_COMMAND ""
)